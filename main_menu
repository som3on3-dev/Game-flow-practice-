function main_menu(~,~)

f= figure;

p= uipanel('parent',f, ...
    'title', 'MAIN MENU', ...
    'position', [0.1 0.1 0.8 0.8]);


uicontrol('Parent', f, ...
    'Style','text', ...
    'String', 'WELCOME!', ...
    'fontsize', 30, ...
    'Position', [230 190 300 200]);
    

 uicontrol('parent' ,p, ...
    'style', 'pushbutton', ...
    'string', 'START', ...
    'Callback', @startgame, ...
    'position', [250 90 100 50]);

function startgame(~,~)
      if exist('piano_game.m', 'file')
         instructions();
         disp("LET'S GO!")
      else 
         msgbox('something went wrong. file not found')
      end
end

uicontrol('parent', p, ...
     'style', 'pushbutton', ...
     'string', 'EXIT', ...
     'Callback', @exit, ...
     'position', [250 30 100 50]);


    function exit(~,~)
        close(f);
    end
end